    "markers": "python3 pipeline/lib/build_markers.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "alfurqan": "^0.0.3",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "wrangler": "^4.0.0"
  },
  "description": "A 16-line Indo-Pak Mushaf reader built for hifz — and for the person listening to a student recite.",
