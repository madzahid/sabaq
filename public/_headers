# Cloudflare Pages — cache rules.
# The Quran does not change, so its data and font are immutable. The HTML is
# not: a stale index.html would pin a reader to an old build forever.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/about.html
  Cache-Control: public, max-age=0, must-revalidate

/guide.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

/data/quran.sqlite.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/gzip

/img/*
  Cache-Control: public, max-age=31536000, immutable
